# Backend Environment Variables Example
SERVER_PORT=8080

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pilates_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Supabase Auth Configuration
# Secret key dùng để giải mã JWT nếu dự án dùng HMAC HS256, hoặc URL JWKS
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-admin-only
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
